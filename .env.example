# Praxis backend configuration. Copy to .env and adjust.
PORT=8080
NODE_ENV=development
# Persistence backend for the runtime: "memory" (default, self-contained) or "prisma" (Postgres).
PERSISTENCE=memory
# Required only when PERSISTENCE=prisma.
DATABASE_URL=postgresql://praxis:praxis@localhost:5432/praxis
# Bearer token guarding the human governance plane (/gov/*). Set a strong value in production.
GOV_API_KEY=dev-supervisor-key
LOG_LEVEL=info
# Allowed clock skew (ms) when validating iat/exp on signed objects.
SIGNATURE_SKEW_MS=2000
