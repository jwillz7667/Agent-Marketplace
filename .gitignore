# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Environment & secrets — never commit real values (.env.example is the template)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma generated client (regenerated via `pnpm prisma:generate`)
prisma/generated/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Misc
tmp/
.cache/
